# NutriTrack AI Environment Variables

# Backend Configuration
PROJECT_NAME="NutriTrack AI"
SECRET_KEY="replace-with-your-production-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (Default: local SQLite; production: PostgreSQL)
# Example: postgresql://postgres:password@localhost:5432/nutritrack
DATABASE_URL="sqlite:///./nutritrack.db"

# External Nutrition Services
# Free API key from https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY="DEMO_KEY"

# Open Food Facts API (CC-BY-SA)
OPEN_FOOD_FACTS_BASE_URL="https://world.openfoodfacts.org/api/v2"

# Image Upload Limits
MAX_IMAGE_SIZE_BYTES=10485760
